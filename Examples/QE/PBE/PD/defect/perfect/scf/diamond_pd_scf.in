&CONTROL
  calculation = 'scf',
  prefix      = 'diamond_pd',
  outdir      = '../tmp/',
  pseudo_dir  = '../../../pseudos/',
  verbosity = 'high',
  tprnfor = .true.,
  tstress = .true.,
  forc_conv_thr = 5.0d-4,
  etot_conv_thr = 1.0d-4,
  restart_mode = 'from_scratch',
  nstep         = 140,
  disk_io = 'low',
/

&SYSTEM
  ibrav =  0,
  nat  = 216,
  ntyp = 1,
  ecutwfc = 45.0,
  ecutrho = 180.0,
  !occupations = 'smearing',
  !smearing    = 'gaussian'
  !degauss     = 0.005
  nspin       = 2
  !starting_magnetization(1) = 0.0
  tot_magnetization = 0.0
  nbnd = 861,
/

&ELECTRONS
  conv_thr = 1.0d-8,
  electron_maxstep = 100,
  mixing_beta = 0.7,
  mixing_mode = 'plain',
  scf_must_converge = .TRUE.,
  startingwfc = 'random',
/

